{
  "name": "academy-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter @academy/shared --filter @academy/api-client build",
    "dev:api": "pnpm --filter @academy/api dev",
    "dev:web": "pnpm --filter @academy/web dev",
    "dev:mobile": "pnpm --filter @academy/mobile dev",
    "dev": "pnpm build:packages && pnpm --parallel --filter @academy/api --filter @academy/web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build": "pnpm build:packages && pnpm --filter @academy/api --filter @academy/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
