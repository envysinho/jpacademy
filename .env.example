# --- PostgreSQL (docker compose lee este archivo si lo copias a .env) ---
POSTGRES_USER=academy
POSTGRES_PASSWORD=academy_dev_only
POSTGRES_DB=academy
POSTGRES_PORT=5432

# --- API (apps/api/.env) ---
# Variables de servidor: NUNCA van en el cliente.
DATABASE_URL=postgresql://academy:academy_dev_only@localhost:5432/academy?schema=public
API_PORT=3000

# --- Web (apps/web/.env) --- las variables VITE_* son PÚBLICAS (quedan en el bundle)
# VITE_API_URL=http://localhost:3000

# --- Mobile (apps/mobile/.env) --- las EXPO_PUBLIC_* son PÚBLICAS (quedan en el bundle)
# 10.0.2.2 = localhost del PC visto desde el emulador Android; en tablet física usa la IP LAN del PC
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
