# Las variables EXPO_PUBLIC_* son PÚBLICAS: quedan embebidas en la app. Nunca pongas secretos aquí.
# 10.0.2.2 = localhost del PC visto desde el emulador Android; en tablet física usa la IP LAN del PC.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Solo desarrollo/pruebas: habilita las cuatro cuentas ficticias descritas en docs/AUTH_DEMO.md.
# La autenticación demo también exige __DEV__, por lo que queda inactiva en builds de producción.
EXPO_PUBLIC_DEMO_AUTH_ENABLED=false
